# Required. Standard Base64 that decodes to 32 bytes.
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
BOOKMARK_SECRET_KEY=

# SQLite file. Relative paths are resolved from the process working directory.
# `pnpm dev` runs in app/, so this file is app/data/bookmark.db.
# The container image defaults to /data/bookmark.db.
DATABASE_PATH=./data/bookmark.db

# Optional override for the Drizzle migrations directory.
# Local default: app/drizzle. Container default: /app/drizzle.
# MIGRATIONS_FOLDER=

# Bootstrap admin created on first start when both are set. The account is break-glass.
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Optional persistent admin token, reconciled on EVERY start (bp_ + 32 random bytes).
# Generate: node -e "console.log('bp_' + require('crypto').randomBytes(32).toString('base64url'))"
ADMIN_API_TOKEN=
# Alternatively mount a secret file. Set only one token source.
# ADMIN_API_TOKEN_FILE=/run/secrets/bookmarks_admin_api_token

# Set to false to allow password login only for break-glass users.
LOCAL_LOGIN_ENABLED=true

# Set to true behind HTTPS so the session cookie is marked Secure.
SESSION_COOKIE_SECURE=false

# OIDC. All four of the URL, client id, secret, and redirect URI are required to enable it.
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=
# Optional top-level silent sign-in; enabled only when OIDC is configured.
OIDC_AUTO_LOGIN=false
OIDC_AUTO_LOGIN_RETRY_SECONDS=3600
OIDC_PROVIDER_NAME=OpenID
OIDC_ROLE_CLAIM=roles
# JSON object of claim value to viewer, editor, or admin. Unmapped users become viewers.
OIDC_ROLE_MAPPING={}

# Trusted reverse-proxy headers. Ignored unless the TCP peer is inside AUTH_TRUSTED_PROXIES.
AUTH_TRUSTED_HEADER_ENABLED=false
AUTH_TRUSTED_PROXIES=
AUTH_USER_HEADER=Remote-User
AUTH_EMAIL_HEADER=
AUTH_GROUPS_HEADER=
AUTH_GROUP_ROLE_MAPPING={}

# Delete audit rows older than this many days on startup. 0 keeps them.
AUDIT_RETENTION_DAYS=365

# Optional bearer token for GET /metrics. Leave empty to leave metrics open.
METRICS_TOKEN=

# Fastest server or browser check interval, and how many server checks run at once.
CHECK_MIN_INTERVAL_SECONDS=15
CHECK_CONCURRENCY=4

# Action executions allowed per user in a 15 minute window.
ACTION_RATE_LIMIT=30
ACTION_RATE_WINDOW_MS=900000

# Favicon fetch limits. TLS verification and the refresh period are also admin settings.
FAVICON_TIMEOUT_MS=5000
FAVICON_MAX_BYTES=524288

# Ansible clients read BOOKMARKS_API_URL and BOOKMARKS_API_TOKEN, or
# BOOKMARKS_USERNAME and BOOKMARKS_PASSWORD for session login.
# The server does not. See docs/ansible.md.
