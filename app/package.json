{
  "name": "bookmark-page",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "NODE_OPTIONS='--env-file-if-exists=../.env' nuxt dev",
    "generate": "nuxt generate",
    "preview": "NODE_OPTIONS='--env-file-if-exists=../.env' nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . && prettier --check --config ../.prettierrc.json --ignore-path ../.prettierignore ..",
    "format": "eslint . --fix && prettier --write --config ../.prettierrc.json --ignore-path ../.prettierignore ..",
    "typecheck": "nuxt typecheck",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@node-rs/argon2": "2.2.2",
    "@nuxt/ui": "4.11.3",
    "@xmldom/xmldom": "0.9.12",
    "better-sqlite3": "13.0.3",
    "drizzle-orm": "0.45.4",
    "lucide-static": "1.55.0",
    "nuxt": "4.6.1",
    "openid-client": "6.8.8",
    "tailwindcss": "4.3.3",
    "uuid": "14.0.3",
    "vue": "3.5.43",
    "vue-router": "5.4.0",
    "zod": "4.6.6"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@nuxt/test-utils": "4.3.3",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "^24.19.2",
    "@vue/test-utils": "2.5.1",
    "drizzle-kit": "0.31.11",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "happy-dom": "20.14.6",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "vue-tsc": "3.3.13"
  }
}
