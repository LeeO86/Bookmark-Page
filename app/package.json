{
  "name": "bookmark-page",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.15.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "NODE_OPTIONS='--env-file-if-exists=../.env' nuxt dev",
    "generate": "nuxt generate",
    "preview": "NODE_OPTIONS='--env-file-if-exists=../.env' nuxt preview",
    "postinstall": "nuxt prepare",
    "lint": "eslint . && prettier --check --config ../.prettierrc.json --ignore-path ../.prettierignore ..",
    "format": "eslint . --fix && prettier --write --config ../.prettierrc.json --ignore-path ../.prettierignore ..",
    "typecheck": "nuxt typecheck"
  },
  "dependencies": {
    "@nuxt/ui": "4.11.3",
    "nuxt": "4.6.1",
    "tailwindcss": "4.3.3",
    "vue": "3.5.43",
    "vue-router": "5.4.0"
  },
  "devDependencies": {
    "@nuxt/eslint": "1.17.0",
    "@types/node": "^24.19.2",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vue-tsc": "3.3.13"
  }
}
